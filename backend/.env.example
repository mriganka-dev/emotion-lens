# Model settings
# Path to simple_cnn.keras (relative to backend folder or absolute path)
MODEL_PATH=

# Optional download URL if the model file is not included locally
MODEL_URL=

# Server and network settings
HOST=
PORT=

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=

# Maximum allowed file upload size in megabytes
MAX_UPLOAD_MB=

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=

